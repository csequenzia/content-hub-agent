# Copy to .env for local runs. On Railway, set these as service Variables instead.
# Never commit the real .env.

# Required for `edit`, `scan`, `watch`. Create in console.anthropic.com under the business account.
ANTHROPIC_API_KEY=

# Optional tuning
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
MAX_BUDGET_USD=2.00
WHISPER_MODEL=base.en
POLL_MINUTES=30

# Railway: mount a volume at /data and point this at it
# DATA_DIR=/data

