# Copy to .env for local runs. On Railway, set these as service Variables instead.
# Never commit the real .env.

# Required for `edit`, `scan`, `watch`. Create in console.anthropic.com under the business account.
ANTHROPIC_API_KEY=

# Required for the upload page: the password testers type in the browser
APP_PASSWORD=

# Optional tuning
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
MAX_BUDGET_USD=2.00
WHISPER_MODEL=base.en
POLL_MINUTES=30
MAX_UPLOAD_MB=2000

# Course lessons. Images need a Higgsfield API key, "<key id>:<key secret>".
# Without it lessons render without picture beats.
HIGGSFIELD_API_KEY=
# HIGGSFIELD_IMAGE_MODEL=recraft/v4.1/text-to-image
COURSE_MAX_BUDGET_USD=5.00
MAX_COURSE_IMAGES=10

# App API (docs/API.md): the token apps send as "Authorization: Bearer <token>"
HUB_API_TOKEN=
# Cloudflare R2 bucket for app uploads and drafts (R2 -> Manage API tokens, Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Railway: mount a volume at /data and point this at it
# DATA_DIR=/data

# ---- Later (stubs today) ----
# Google Drive handoff (hub/integrations/drive.py)
# GOOGLE_SERVICE_ACCOUNT_JSON=
# DRIVE_ROOT_FOLDER_ID=
# GoHighLevel (hub/integrations/ghl.py)
# GHL_API_TOKEN=
# GHL_LOCATION_ID=
# Base44 (hub/integrations/base44.py)
# BASE44_APP_ID=
# BASE44_API_KEY=
